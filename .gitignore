# ---- Secrets: NEVER commit ----
# src/config.py holds real WiFi credentials on a working device. The repo
# ships src/config.example.py instead, generated by build_mpy.ps1 with
# credentials scrubbed.
src/config.py

# Credentials written by the captive setup portal at runtime
wifi.json

# ---- Runtime files created on the ESP32 (not source) ----
settings.json
events.log

# ---- build/ IS committed ----
# It's what the OTA updater publishes - devices fetch build/manifest.json
# and the files it lists. Two exceptions:
build/config.py         # would contain real credentials
build/.last_deploy      # local bookkeeping, not part of a release

# ---- Local scratch ----
verify_tmp/
tls_test.py

# Python
__pycache__/
*.pyc

# Editor
.vscode/
.idea/
.claude/

# OS
.DS_Store
Thumbs.db
