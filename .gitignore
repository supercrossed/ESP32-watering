# ---- Secrets: NEVER commit ----
# src/config.py holds real WiFi credentials on a working device. The repo
# ships src/config.example.py instead, generated by build_mpy.ps1 with
# credentials scrubbed.
src/config.py

# Credentials written by the captive setup portal at runtime
wifi.json

# ---- Runtime files created on the ESP32 (not source) ----
settings.json
events.log

# ---- build/ IS committed ----
# It's what the OTA updater publishes - devices fetch build/manifest.json
# and the files it lists. Two exceptions below.
#
# NOTE: git does NOT support trailing comments on a pattern line - the
# comment becomes part of the filename and the rule silently never matches.
# Keep comments on their own lines. (This exact mistake published real WiFi
# credentials to a public repo once.)
#
# would contain real WiFi credentials
build/config.py
# local deploy bookkeeping, not part of a release
build/.last_deploy

# ---- Local scratch ----
verify_tmp/
tls_test.py

# Python
__pycache__/
*.pyc

# Editor
.vscode/
.idea/
.claude/

# OS
.DS_Store
Thumbs.db
